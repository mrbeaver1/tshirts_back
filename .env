# Настройки приложения
APP_PORT=8080
APP_ENV=development

# DB
DB_USER=user
DB_PASSWORD=pass
DB_DBNAME=t_shirts
DB_PORT=5432
DB_HOST=localhost
DB_SSL_MODE=disable
DB_DSN=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DBNAME}?sslmode=${DB_SSL_MODE}

# Keycloak
KC_URL=localhost
KC_HOSTNAME_PORT=8099
KC_DB_TYPE=postgres
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB_HOST=keycloak-db
KC_DB_USER=ckuser
KC_DB_PASSWORD=ckpass
KC_DB_DBNAME=ckdb
KC_DB_PORT=5433

# S3 (MinIO)
S3_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=photos
S3_REGION=us-east-1

# Redis
REDIS_URL=redis:6379
REDIS_PASSWORD=

# Mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=